<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VIKTOR // AETHER — Digital Identity & Portfolio</title>

  <!-- =====================================================================
       1. GOOGLE FONTS & ICON LIBRARY
       - 'Orbitron': Futuristic geometric display font for headings & brand
       - 'Space Grotesk': Clean modern sans-serif for readable body text
       - 'Fira Code': Monospace developer font for code tags, dates & stats
       - Font Awesome: Used for social media and UI icons
       ===================================================================== -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Orbitron:wght@500;700;900&family=Space+Grotesk:wght@300;400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <style>
    /* =====================================================================
       2. CSS CUSTOM PROPERTIES (COLOR PALETTE & THEME VARIABLES)
       Requirement 1 & 4: Palette of 4 core neon colors + Light/Dark Mode.
       By storing colors in CSS variables (--bg-primary, --neon-cyan, etc.),
       JavaScript can switch the entire website theme by changing ONE attribute!
       ===================================================================== */
    :root {
      /* Core 4-Color Neon Palette */
      --neon-cyan: #00f3ff;
      --neon-magenta: #ff00ff;
      --neon-purple: #9d00ff;
      --neon-lime: #00ff9d;

      /* Dark Mode Default Surfaces */
      --bg-primary: #06060e;
      --bg-secondary: #0d0d1d;
      --bg-card: rgba(16, 16, 36, 0.78);
      --text-primary: #f2f5ff;
      --text-secondary: #a6b0d6;
      --border-glow: rgba(0, 243, 255, 0.35);
      --nav-bg: rgba(6, 6, 14, 0.85);
      --shadow-neon: 0 0 20px rgba(0, 243, 255, 0.25), 0 0 40px rgba(255, 0, 255, 0.12);
    }

    /* Light Mode Override ("Solar Prism" High-Contrast Neon Daylight) */
    [data-theme="light"] {
      --neon-cyan: #0077cc;
      --neon-magenta: #c4009c;
      --neon-purple: #6200ea;
      --neon-lime: #008f5a;

      --bg-primary: #f4f6ff;
      --bg-secondary: #e6ebfa;
      --bg-card: rgba(255, 255, 255, 0.9);
      --text-primary: #101326;
      --text-secondary: #3f4769;
      --border-glow: rgba(98, 0, 234, 0.3);
      --nav-bg: rgba(244, 246, 255, 0.9);
      --shadow-neon: 0 10px 30px rgba(98, 0, 234, 0.12);
    }

    /* =====================================================================
       3. GLOBAL RESET & BASE STYLES
       ===================================================================== */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth; /* Smooth scrolling when clicking nav links */
    }

    body {
      font-family: 'Space Grotesk', sans-serif;
      background-color: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.7;
      overflow-x: hidden;
      transition: background-color 0.4s ease, color 0.4s ease;
    }

    h1, h2, h3, .brand-font {
      font-family: 'Orbitron', sans-serif;
      letter-spacing: 1.5px;
    }

    .mono-font {
      font-family: 'Fira Code', monospace;
    }

    /* =====================================================================
       4. EXTRA CHALLENGE: TOP SCROLL PROGRESS BAR
       Shows how far down the page the visitor has scrolled.
       ===================================================================== */
    #scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 4px;
      background: linear-gradient(90deg, var(--neon-cyan), var(--neon-magenta), var(--neon-purple));
      z-index: 9999;
      box-shadow: 0 0 12px var(--neon-cyan);
      transition: width 0.1s linear;
    }

    /* =====================================================================
       5. NAVIGATION BAR (Requirement 11) & THEME TOGGLE (Requirement 4)
       ===================================================================== */
    header {
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 1000;
      background: var(--nav-bg);
      backdrop-filter: blur(14px); /* Frosted glass effect */
      border-bottom: 1px solid var(--border-glow);
      transition: all 0.3s ease;
    }

    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0.85rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: var(--text-primary);
      font-weight: 900;
      font-size: 1.15rem;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      list-style: none;
    }

    .nav-links a {
      text-decoration: none;
      color: var(--text-primary);
      font-family: 'Orbitron', sans-serif;
      font-size: 0.8rem;
      font-weight: 600;
      position: relative;
      padding: 0.3rem 0;
      transition: color 0.3s ease;
    }

    /* Neon underline hover animation */
    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0%;
      height: 2px;
      background: linear-gradient(90deg, var(--neon-cyan), var(--neon-magenta));
      transition: width 0.3s ease;
    }

    .nav-links a:hover {
      color: var(--neon-cyan);
    }

    .nav-links a:hover::after {
      width: 100%;
    }

    /* Light / Dark Mode Button */
    #theme-toggle {
      background: transparent;
      border: 1.5px solid var(--neon-cyan);
      color: var(--text-primary);
      padding: 0.45rem 0.9rem;
      border-radius: 50px;
      cursor: pointer;
      font-family: 'Fira Code', monospace;
      font-size: 0.8rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      box-shadow: 0 0 10px rgba(0, 243, 255, 0.2);
      transition: all 0.3s ease;
    }

    #theme-toggle:hover {
      background: var(--neon-cyan);
      color: #06060e;
      box-shadow: 0 0 20px var(--neon-cyan);
      transform: translateY(-2px);
    }

    .mobile-menu-btn {
      display: none;
      background: none;
      border: none;
      color: var(--neon-cyan);
      font-size: 1.5rem;
      cursor: pointer;
    }

    /* =====================================================================
       6. HERO / HOME SECTION (Requirement 2 & 3)
       Uses parallax background + custom animated SVG logo + typing effect.
       ===================================================================== */
    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      padding: 6rem 1.5rem 4rem;
      /* Parallax background: replace 'hero-bg.jpg' with your saved hero image */
      background-image:
        radial-gradient(circle at center, rgba(6, 6, 14, 0.45) 0%, rgba(6, 6, 14, 0.92) 100%),
        url('hero-bg.jpg');
      background-attachment: fixed;
      background-position: center;
      background-size: cover;
      overflow: hidden;
    }

    /* Animated cyber grid floor overlay */
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(0, 243, 255, 0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 0, 255, 0.07) 1px, transparent 1px);
      background-size: 50px 50px;
      pointer-events: none;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 850px;
    }

    /* Custom SVG Logo Glow & Float Animation */
    .hero-logo-svg {
      width: 130px;
      height: 130px;
      margin: 0 auto 1.25rem;
      filter: drop-shadow(0 0 18px rgba(0, 243, 255, 0.75));
      animation: floatLogo 4s ease-in-out infinite;
    }

    @keyframes floatLogo {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    /* SVG path animations inside the logo */
    .svg-spin-slow {
      transform-origin: 50% 50%;
      animation: spinSlow 18s linear infinite;
    }

    .svg-pulse-wave {
      stroke-dasharray: 120;
      stroke-dashoffset: 120;
      animation: drawWave 3s ease-in-out infinite alternate;
    }

    @keyframes spinSlow {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    @keyframes drawWave {
      to { stroke-dashoffset: 0; }
    }

    .hero-title {
      font-size: clamp(2.2rem, 6vw, 4.2rem);
      font-weight: 900;
      color: #ffffff;
      text-transform: uppercase;
      text-shadow: 0 0 15px var(--neon-cyan), 0 0 35px var(--neon-magenta);
      margin-bottom: 0.5rem;
    }

    .hero-slogan {
      font-size: clamp(0.95rem, 2.2vw, 1.25rem);
      color: #d8e2ff;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-bottom: 1.8rem;
    }

    /* Mandatory Dynamic Typing Container (Requirement 3) */
    .typing-box {
      display: inline-block;
      background: rgba(10, 10, 26, 0.78);
      border: 1px solid var(--neon-cyan);
      box-shadow: 0 0 25px rgba(0, 243, 255, 0.3);
      padding: 0.85rem 1.75rem;
      border-radius: 12px;
      font-family: 'Fira Code', monospace;
      font-size: clamp(1.05rem, 2.5vw, 1.5rem);
      color: var(--neon-cyan);
      margin-bottom: 2.2rem;
    }

    .cursor {
      display: inline-block;
      width: 3px;
      height: 1.2em;
      background-color: var(--neon-magenta);
      margin-left: 4px;
      vertical-align: middle;
      animation: blinkCursor 0.8s infinite;
    }

    @keyframes blinkCursor {
      0%, 49% { opacity: 1; }
      50%, 100% { opacity: 0; }
    }

    .hero-cta-group {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn-neon {
      padding: 0.85rem 1.8rem;
      border-radius: 8px;
      font-family: 'Orbitron', sans-serif;
      font-size: 0.85rem;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.3s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-neon-primary {
      background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple));
      color: #ffffff;
      border: none;
      box-shadow: 0 0 20px rgba(0, 243, 255, 0.4);
    }

    .btn-neon-primary:hover {
      transform: translateY(-3px) scale(1.03);
      box-shadow: 0 0 30px var(--neon-magenta);
    }

    .btn-neon-outline {
      background: rgba(6, 6, 14, 0.65);
      color: #ffffff;
      border: 1.5px solid var(--neon-magenta);
    }

    .btn-neon-outline:hover {
      background: var(--neon-magenta);
      color: #ffffff;
      box-shadow: 0 0 25px var(--neon-magenta);
    }

    /* =====================================================================
       7. REUSABLE SECTION LAYOUT & SCROLL REVEAL ANIMATION
       ===================================================================== */
    section {
      padding: 5.5rem 1.5rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-header {
      text-align: center;
      margin-bottom: 3.5rem;
    }

    .section-tag {
      font-family: 'Fira Code', monospace;
      color: var(--neon-magenta);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      display: block;
      margin-bottom: 0.4rem;
    }

    .section-title {
      font-size: clamp(1.8rem, 4vw, 2.6rem);
      background: linear-gradient(90deg, var(--neon-cyan), var(--neon-magenta));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 0.75rem;
    }

    .section-divider {
      width: 90px;
      height: 3px;
      background: linear-gradient(90deg, var(--neon-cyan), var(--neon-magenta));
      margin: 0 auto;
      border-radius: 3px;
      box-shadow: 0 0 12px var(--neon-cyan);
    }

    /* Scroll Reveal Class (Activated via IntersectionObserver in JS) */
    .reveal {
      opacity: 0;
      transform: translateY(35px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }

    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }

    /* =====================================================================
       8. ABOUT ME SECTION (Requirement 5)
       ===================================================================== */
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1.35fr;
      gap: 3rem;
      align-items: center;
      background: var(--bg-card);
      border: 1px solid var(--border-glow);
      border-radius: 20px;
      padding: 2.5rem;
      box-shadow: var(--shadow-neon);
    }

    .portrait-wrapper {
      position: relative;
      border-radius: 16px;
      padding: 6px;
      background: linear-gradient(135deg, var(--neon-cyan), var(--neon-magenta), var(--neon-purple));
      box-shadow: 0 0 28px rgba(0, 243, 255, 0.35);
    }

    .portrait-wrapper img {
      width: 100%;
      display: block;
      border-radius: 12px;
      object-fit: cover;
      aspect-ratio: 3 / 4;
      transition: transform 0.4s ease;
    }

    .portrait-wrapper:hover img {
      transform: scale(1.02);
    }

    .about-badge {
      position: absolute;
      bottom: 16px;
      left: 16px;
      background: rgba(6, 6, 14, 0.88);
      border: 1px solid var(--neon-cyan);
      color: var(--neon-cyan);
      padding: 0.35rem 0.85rem;
      border-radius: 50px;
      font-family: 'Fira Code', monospace;
      font-size: 0.75rem;
    }

    .about-text h3 {
      font-size: 1.5rem;
      margin-bottom: 1rem;
      color: var(--neon-cyan);
    }

    .about-text p {
      color: var(--text-secondary);
      margin-bottom: 1.1rem;
      font-size: 1.03rem;
    }

    .identity-pillars {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.9rem;
      margin-top: 1.5rem;
    }

    .pillar-item {
      background: var(--bg-secondary);
      border-left: 3px solid var(--neon-magenta);
      padding: 0.75rem 1rem;
      border-radius: 8px;
      font-size: 0.9rem;
    }

    .pillar-item strong {
      display: block;
      color: var(--text-primary);
      font-family: 'Orbitron', sans-serif;
      font-size: 0.8rem;
    }

    /* =====================================================================
       9. MY SKILLS SECTION (Requirement 6: 5 Progress Bars + Stats)
       ===================================================================== */
    .skills-container {
      background: var(--bg-card);
      border: 1px solid var(--border-glow);
      border-radius: 20px;
      padding: 2.5rem;
      box-shadow: var(--shadow-neon);
    }

    .skill-item {
      margin-bottom: 1.6rem;
    }

    .skill-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.45rem;
      font-weight: 600;
    }

    .skill-name i {
      color: var(--neon-cyan);
      margin-right: 0.5rem;
    }

    .skill-percent {
      font-family: 'Fira Code', monospace;
      color: var(--neon-magenta);
    }

    .progress-track {
      width: 100%;
      height: 14px;
      background: var(--bg-secondary);
      border-radius: 50px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .progress-fill {
      height: 100%;
      width: 0%; /* Starts at 0 and animates to data-width via JS */
      border-radius: 50px;
      background: linear-gradient(90deg, var(--neon-cyan), var(--neon-magenta));
      box-shadow: 0 0 14px var(--neon-cyan);
      transition: width 1.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Animated Counters Row (Extra Challenge) */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
      margin-top: 2.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border-glow);
      text-align: center;
    }

    .stat-box {
      background: var(--bg-secondary);
      padding: 1.25rem;
      border-radius: 12px;
      border: 1px solid transparent;
      transition: border-color 0.3s ease;
    }

    .stat-box:hover {
      border-color: var(--neon-cyan);
    }

    .stat-number {
      font-family: 'Orbitron', sans-serif;
      font-size: 2rem;
      font-weight: 900;
      color: var(--neon-cyan);
      display: block;
    }

    .stat-label {
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    /* =====================================================================
       10. MY PORTFOLIO / MY WORLD (Requirement 7: 8+ Works + Lightbox + Filter)
       ===================================================================== */
    .filter-bar {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }

    .filter-btn {
      background: var(--bg-card);
      color: var(--text-primary);
      border: 1px solid var(--border-glow);
      padding: 0.5rem 1.2rem;
      border-radius: 50px;
      font-family: 'Fira Code', monospace;
      font-size: 0.82rem;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .filter-btn.active, .filter-btn:hover {
      background: linear-gradient(90deg, var(--neon-cyan), var(--neon-magenta));
      color: #ffffff;
      border-color: transparent;
      box-shadow: 0 0 15px rgba(0, 243, 255, 0.4);
    }

    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.5rem;
    }

    .portfolio-card {
      background: var(--bg-card);
      border: 1px solid var(--border-glow);
      border-radius: 16px;
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
      display: flex;
      flex-direction: column;
    }

    .portfolio-card:hover {
      transform: translateY(-8px);
      border-color: var(--neon-magenta);
      box-shadow: 0 12px 30px rgba(255, 0, 255, 0.25);
    }

    .portfolio-thumb {
      width: 100%;
      height: 190px;
      background: #090918;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .portfolio-thumb svg {
      width: 100%;
      height: 100%;
      transition: transform 0.5s ease;
    }

    .portfolio-card:hover .portfolio-thumb svg {
      transform: scale(1.08);
    }

    .portfolio-info {
      padding: 1.25rem;
      flex-grow: 1;
    }

    .portfolio-cat {
      font-family: 'Fira Code', monospace;
      font-size: 0.72rem;
      color: var(--neon-cyan);
      text-transform: uppercase;
    }

    .portfolio-info h3 {
      font-size: 1.05rem;
      margin: 0.3rem 0 0.5rem;
    }

    .portfolio-info p {
      font-size: 0.88rem;
      color: var(--text-secondary);
    }

    /* =====================================================================
       11. BLOG SECTION (Requirement 8: 3+ Posts + Read More Modal)
       ===================================================================== */
    .blog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
      gap: 2rem;
    }

    .blog-card {
      background: var(--bg-card);
      border: 1px solid var(--border-glow);
      border-radius: 18px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-neon);
      transition: transform 0.3s ease;
    }

    .blog-card:hover {
      transform: translateY(-6px);
    }

    .blog-cover {
      height: 180px;
      width: 100%;
      background: #080814;
    }

    .blog-body {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .blog-date {
      font-family: 'Fira Code', monospace;
      font-size: 0.78rem;
      color: var(--neon-magenta);
      margin-bottom: 0.4rem;
    }

    .blog-body h3 {
      font-size: 1.2rem;
      margin-bottom: 0.75rem;
      line-height: 1.4;
    }

    .blog-excerpt {
      color: var(--text-secondary);
      font-size: 0.94rem;
      margin-bottom: 1.5rem;
      flex-grow: 1;
    }

    .read-more-btn {
      align-self: flex-start;
      background: transparent;
      border: 1.5px solid var(--neon-cyan);
      color: var(--neon-cyan);
      padding: 0.55rem 1.25rem;
      border-radius: 6px;
      font-family: 'Orbitron', sans-serif;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .read-more-btn:hover {
      background: var(--neon-cyan);
      color: #06060e;
      box-shadow: 0 0 18px var(--neon-cyan);
    }

    /* =====================================================================
       12. CONTACT & SOCIAL NETWORKS SECTION (Requirement 9 & 10)
       ===================================================================== */
    .contact-wrapper {
      display: grid;
      grid-template-columns: 1fr 1.3fr;
      gap: 2.5rem;
      background: var(--bg-card);
      border: 1px solid var(--border-glow);
      border-radius: 20px;
      padding: 2.5rem;
      box-shadow: var(--shadow-neon);
    }

    .social-cards {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .social-link-card {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.9rem 1.2rem;
      background: var(--bg-secondary);
      border: 1px solid var(--border-glow);
      border-radius: 12px;
      text-decoration: none;
      color: var(--text-primary);
      transition: all 0.3s ease;
    }

    .social-link-card:hover {
      border-color: var(--neon-cyan);
      transform: translateX(6px);
      box-shadow: 0 0 15px rgba(0, 243, 255, 0.25);
    }

    .social-link-card i {
      font-size: 1.4rem;
      color: var(--neon-cyan);
      width: 28px;
      text-align: center;
    }

    .form-group {
      margin-bottom: 1.25rem;
    }

    .form-group label {
      display: block;
      font-family: 'Fira Code', monospace;
      font-size: 0.85rem;
      margin-bottom: 0.4rem;
      color: var(--neon-cyan);
    }

    .form-control {
      width: 100%;
      padding: 0.85rem 1rem;
      border-radius: 10px;
      border: 1.5px solid var(--border-glow);
      background: var(--bg-secondary);
      color: var(--text-primary);

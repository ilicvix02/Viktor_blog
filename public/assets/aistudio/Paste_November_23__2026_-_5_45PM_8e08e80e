  <!-- =====================================================================
       JAVASCRIPT: ALL INTERACTIVE & DYNAMIC FEATURES
       ===================================================================== -->
  <script>
    /* ---------------------------------------------------------------------
       A. MANDATORY DYNAMIC EFFECT: TYPEWRITER HERO TITLE (Requirement 3)
       Cycles through phrases letter-by-letter, pauses, deletes, and repeats.
       --------------------------------------------------------------------- */
    const phrases = [
      "I am an AI vibecoder.",
      "I am a poet & lyricist.",
      "I am a vocalist & sound explorer.",
      "I am a seeker of higher consciousness."
    ];

    const typedTextElement = document.getElementById("typed-text");
    let phraseIndex = 0;
    let charIndex = 0;
    let isDeleting = false;

    function typeEffect() {
      const currentPhrase = phrases[phraseIndex];

      if (isDeleting) {
        // Remove one character
        typedTextElement.textContent = currentPhrase.substring(0, charIndex - 1);
        charIndex--;
      } else {
        // Add one character
        typedTextElement.textContent = currentPhrase.substring(0, charIndex + 1);
        charIndex++;
      }

      // Control typing and deleting speed
      let speed = isDeleting ? 45 : 85;

      if (!isDeleting && charIndex === currentPhrase.length) {
        // Pause when full phrase is typed
        speed = 1800;
        isDeleting = true;
      } else if (isDeleting && charIndex === 0) {
        // Move to next phrase once deleted
        isDeleting = false;
        phraseIndex = (phraseIndex + 1) % phrases.length;
        speed = 400;
      }

      setTimeout(typeEffect, speed);
    }
    // Start typing animation immediately on page load
    typeEffect();

    /* ---------------------------------------------------------------------
       B. LIGHT / DARK MODE THEME SWITCHER (Requirement 4)
       Toggles data-theme="dark" / "light" on <html> and updates button text.
       --------------------------------------------------------------------- */
    const themeToggleBtn = document.getElementById("theme-toggle");
    const themeIcon = document.getElementById("theme-icon");
    const themeLabel = document.getElementById("theme-label");
    const htmlRoot = document.documentElement;

    themeToggleBtn.addEventListener("click", () => {
      const currentTheme = htmlRoot.getAttribute("data-theme");
      const nextTheme = currentTheme === "dark" ? "light" : "dark";
      htmlRoot.setAttribute("data-theme", nextTheme);

      if (nextTheme === "light") {
        themeIcon.textContent = "🌙";
        themeLabel.textContent = "Dark Mode";
      } else {
        themeIcon.textContent = "☀";
        themeLabel.textContent = "Light Mode";
      }
    });

    /* ---------------------------------------------------------------------
       C. MOBILE NAVIGATION MENU TOGGLE (Requirement 11)
       --------------------------------------------------------------------- */
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const navLinks = document.getElementById("nav-links");

    mobileMenuBtn.addEventListener("click", () => {
      navLinks.classList.toggle("show");
    });

    // Close mobile menu when a link is clicked
    navLinks.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => navLinks.classList.remove("show"));
    });

    /* ---------------------------------------------------------------------
       D. SCROLL PROGRESS BAR & BACK-TO-TOP VISIBILITY (Extra Challenge)
       --------------------------------------------------------------------- */
    const scrollProgress = document.getElementById("scroll-progress");
    const backToTopBtn = document.getElementById("back-to-top");

    window.addEventListener("scroll", () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const scrollPercent = (scrollTop / docHeight) * 100;
      scrollProgress.style.width = scrollPercent + "%";

      // Show Back-to-Top button after scrolling 400px
      if (scrollTop > 400) {
        backToTopBtn.classList.add("visible");
      } else {
        backToTopBtn.classList.remove("visible");
      }
    });

    backToTopBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    /* ---------------------------------------------------------------------
       E. SCROLL REVEAL + SKILL BAR FILL + COUNTER ANIMATION
       Uses IntersectionObserver to trigger animations when scrolled into view.
       --------------------------------------------------------------------- */
    let countersStarted = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("active");

          // If Skills section enters view, animate progress bars & counters
          if (entry.target.id === "skills") {
            document.querySelectorAll(".progress-fill").forEach(bar => {
              bar.style.width = bar.getAttribute("data-width");
            });

            if (!countersStarted) {
              countersStarted = true;
              document.querySelectorAll(".stat-number").forEach(counter => {
                const target = +counter.getAttribute("data-target");
                let count = 0;
                const increment = Math.ceil(target / 40);
                const updateCount = () => {
                  count += increment;
                  if (count < target) {
                    counter.textContent = count;
                    requestAnimationFrame(updateCount);
                  } else {
                    counter.textContent = target;
                  }
                };
                updateCount();
              });
            }
          }
        }
      });
    }, { threshold: 0.15 });

    document.querySelectorAll(".reveal").forEach(sec => observer.observe(sec));

    /* ---------------------------------------------------------------------
       F. PORTFOLIO CATEGORY FILTERING (Extra Challenge)
       --------------------------------------------------------------------- */
    const filterBtns = document.querySelectorAll(".filter-btn");
    const portfolioCards = document.querySelectorAll(".portfolio-card");

    filterBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        filterBtns.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");

        const filter = btn.getAttribute("data-filter");
        portfolioCards.forEach(card => {
          if (filter === "all" || card.getAttribute("data-category") === filter) {
            card.style.display = "flex";
          } else {
            card.style.display = "none";
          }
        });
      });
    });

    /* ---------------------------------------------------------------------
       G. UNIVERSAL MODAL FOR PORTFOLIO LIGHTBOX (Req 7) & BLOG READER (Req 8)
       --------------------------------------------------------------------- */
    const modal = document.getElementById("universal-modal");
    const modalClose = document.getElementById("modal-close");
    const modalVisual = document.getElementById("modal-visual");
    const modalMeta = document.getElementById("modal-meta");
    const modalTitle = document.getElementById("modal-title");
    const modalBody = document.getElementById("modal-body");

    // Open Portfolio Card in Lightbox Modal
    portfolioCards.forEach(card => {
      card.addEventListener("click", () => {
        const svgClone = card.querySelector(".portfolio-thumb").innerHTML;
        modalVisual.innerHTML = `<div style="height:240px;">${svgClone}</div>`;
        modalMeta.textContent = card.querySelector(".portfolio-cat").textContent;
        modalTitle.textContent = card.getAttribute("data-title");
        modalBody.textContent = card.getAttribute("data-desc");
        modal.classList.add("open");
      });
    });

    // Full Blog Post Data Array (Requirement 8)
    const blogPosts = [
      {
        date: "NOVEMBER 18, 2026 • AI & CREATIVITY",
        title: "Vibecoding: Why Intuition Is the New Programming Language",
        content: `For decades, building software required memorizing thousands of rigid syntax rules before you could bring a single creative vision to life. Today, vibecoding changes the paradigm completely.

When you vibecode, you act as both architect and poet. You communicate intent, aesthetic atmosphere, emotional rhythm, and structural logic to an AI collaborator, iterating in real time until the code resonates with your vision.

For someone passionate about poetry, music, and philosophy, vibecoding removes the wall between imagination and execution. Code becomes another artistic medium—just like a melody or a stanza.`
      },
      {
        date: "NOVEMBER 04, 2026 • ORIGINAL POETRY",
        title: "Original Poem: 'Frequencies Beyond the Screen'",
        content: `Beneath the hum of violet neon skies,
Where data streams like rivers in the night,
A quiet spark within the spirit lies,
Unbound by circuits, forged of living light.

We sing our truths into the endless void,
Each syllable a wave that cannot fade—
No human soul was meant to be deployed
Inside a cage that algorithms made.

So tune your mind beyond the glowing glass,
Where ancient stillness meets the future's dawn;
All fleeting trends of silicon will pass,
While consciousness forever carries on.`
      },
      {
        date: "OCTOBER 21, 2026 • CONSCIOUSNESS & PHILOSOPHY",
        title: "Expanding Consciousness in the Age of Artificial Intelligence",
        content: `Every major technological revolution forces humanity to ask a fundamental question: Who are we when our tools can do what we once thought was uniquely ours?

Artificial Intelligence can generate patterns, analyze data, and assist with code—yet it does not experience the awe of looking up at the stars, the catharsis of singing a heartfelt melody, or the quiet transformation of deep meditation.

To thrive in the coming decades, we must cultivate both intellectual mastery of new tools and deep spiritual self-awareness. True intelligence is not just processing power; it is wisdom, empathy, and conscious presence.`
      }
    ];

    // Open Blog Post in Modal on READ MORE click
    document.querySelectorAll(".read-more-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const post = blogPosts[+btn.getAttribute("data-post")];
        modalVisual.innerHTML = ""; // Text-focused reading view
        modalMeta.textContent = post.date;
        modalTitle.textContent = post.title;
        modalBody.textContent = post.content;
        modal.classList.add("open");
      });
    });

    // Close Modal handlers (X button, backdrop click, or Escape key)
    modalClose.addEventListener("click", () => modal.classList.remove("open"));
    modal.addEventListener("click", (e) => {
      if (e.target === modal) modal.classList.remove("open");
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") modal.classList.remove("open");
    });

    /* ---------------------------------------------------------------------
       H. CONTACT FORM VALIDATION (Requirement 10)
       Checks that Name, valid Email, and Message are entered before confirming.
       --------------------------------------------------------------------- */
    const contactForm = document.getElementById("contact-form");
    const formFeedback = document.getElementById("form-feedback");

    contactForm.addEventListener("submit", (e) => {
      e.preventDefault(); // Prevent page reload

      const nameVal = document.getElementById("name").value.trim();
      const emailVal = document.getElementById("email").value.trim();
      const messageVal = document.getElementById("message").value.trim();
      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      if (!nameVal || !emailVal || !messageVal) {
        formFeedback.className = "error";
        formFeedback.textContent = "⚠ Please fill in all required fields (Name, Email, and Message).";
        return;
      }

      if (!emailPattern.test(emailVal)) {
        formFeedback.className = "error";
        formFeedback.textContent = "⚠ Please enter a valid email address (e.g., name@example.com).";
        return;
      }

      // Exact confirmation message specified in Requirement 10
      formFeedback.className = "success";
      formFeedback.textContent = "✔ Thank you! Your message has been sent.";
      contactForm.reset();
    });
  </script>
